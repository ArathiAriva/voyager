# Copy to .env and fill in values
OPENROUTER_API_KEY=sk-or-...
# Optional: override the default model (default: anthropic/claude-opus-4-8)
# Examples: openai/gpt-4o, google/gemini-2.5-pro, meta-llama/llama-3.3-70b-instruct
# OPENROUTER_MODEL=anthropic/claude-opus-4-8

# Keep for future direct Anthropic SDK phase
# ANTHROPIC_API_KEY=sk-ant-...

# Phoenix tracing (optional). Point at a running Phoenix instance to enable.
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_PROJECT_NAME=voyager

# Local LLM call tracing (optional, no collector needed). Captures every
# non-streaming LLM call — including planner intermediates like build_brief —
# to a JSONL file, readable via `python -m evals.trace_query`.
# Entries hold full prompt/response bodies with no redaction: dev profiles only.
# VOYAGER_TRACE_LLM=1
# VOYAGER_TRACE_PATH=./trace_log.jsonl
# VOYAGER_TRACE_MAX_MB=50
